# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# generated deployment artifacts
.tmp-launchingstack-func/
launchingstack-func-dev-current.zip

# generated lead scrape staging files
/leads/*.csv

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
next-dev.*.log

# env files (can opt-in for committing if needed)
.env*
local.setting.json
local.settings.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
